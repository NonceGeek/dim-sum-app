generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 第三方账号信息表
/// 存储用户通过第三方平台（如微信）登录的账号信息
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  openId            String?
  unionId           String?
  openIdWxService   String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([openId])
}

/// 用户信息表
/// 存储用户的基本信息
model User {
  id                                                                                        String                             @id @default(cuid())
  name                                                                                      String?
  email                                                                                     String?                            @unique
  emailVerified                                                                             DateTime?
  image                                                                                     String?
  phoneNumber                                                                               String?                            @unique
  wechatAvatar                                                                              String?
  role                                                                                      Role                               @default(LEARNER)
  bio                                                                                       String?
  isSystemAdmin                                                                             Boolean                            @default(false)
  ethAddress                                                                                String?                            @unique
  createdAt                                                                                 DateTime                           @default(now()) @db.Timestamptz(6)
  updatedAt                                                                                 DateTime                           @default(now()) @updatedAt @db.Timestamptz(6)
  deletionRequestedAt                                                                       DateTime?                          @db.Timestamptz(6)
  status                                                                                    UserStatus                         @default(ACTIVE)
  mergedIntoId                                                                              String?
  accounts                                                                                  Account[]
  sessions                                                                                  Session[]
  walletNonces                                                                              WalletNonce[]
  api_key                                                                                   api_key[]
  cantonese_corpus_update_history_cantonese_corpus_update_history_contributor_user_idToUser cantonese_corpus_update_history[]  @relation("cantonese_corpus_update_history_contributor_user_idToUser")
  cantonese_corpus_update_history                                                           cantonese_corpus_update_history[]
  corpus_category                                                                           corpus_category[]
  corpusCollectionActivities                                                                corpus_collection_activities[]
  corpusCollectionComments                                                                  corpus_collection_comments[]
  corpusCollectionLikes                                                                     corpus_collection_likes[]
  corpusCollectionMessages                                                                  corpus_collection_messages[]
  corpusCollectionReviewBatches                                                             corpus_collection_review_batches[]
  corpusCollectionReviewedItems                                                             corpus_collection_submissions[]    @relation("CorpusCollectionReviewer")
  corpusCollectionSubmissions                                                               corpus_collection_submissions[]
  corpus_tags                                                                               corpus_tags[]
  gameAnswerRecords                                                                         game_answer_records[]
  gamePlayerProgress                                                                        game_player_progress?
  auditLogsAsOperator                                                                       permission_audit_logs[]            @relation("AuditOperator")
  auditLogsAsTarget                                                                         permission_audit_logs[]            @relation("AuditTarget")
  corpusInteractions                                                                        user_corpus_interactions[]
  corpusPermissions                                                                         user_corpus_permissions[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model api_key {
  id           BigInt    @id @default(autoincrement())
  user_id      String
  key          Bytes
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  status       APIStatus @default(PENDING)
  called_times BigInt    @default(0)
  type         APILevel  @default(NORMAL)
  User         User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model cantonese_categories {
  id                   BigInt                    @default(autoincrement())
  name                 String                    @unique
  nickname             String?
  description          String?
  likes                BigInt?                   @default(0)
  created_at           DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?                 @default(now()) @db.Timestamp(6)
  cover                String?
  link                 String?
  tags                 Json?
  pinned               Boolean                   @default(false)
  editable_level       BigInt                    @default(0)
  if_in_all_data       Boolean                   @default(false)
  related              Json                      @default("{\"apps\": [], \"links\": []}")
  size                 Float?                    @db.Real
  taggers              Json                      @default("[]")
  sorting              BigInt                    @default(0)
  status               CategoryStatus            @default(RAW)
  is_public            Boolean                   @default(true)
  recommend_words      Json                      @default("[]")
  cantonese_corpus_all cantonese_corpus_all[]
  userPermissions      user_corpus_permissions[]

  @@id([id, name])
}

model cantonese_corpus_all {
  id                   BigInt                     @unique @default(autoincrement())
  data                 String
  note                 Json?                      @default("{}")
  category             String
  created_at           DateTime                   @default(now()) @db.Timestamptz(6)
  tags                 Json?                      @default("[]")
  editable_level       Int                        @default(1) @db.SmallInt
  liked_num            BigInt                     @default(0)
  unique_id            String                     @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookmark_num         BigInt                     @default(0)
  view_num             BigInt                     @default(0)
  updated_at           DateTime                   @default(now()) @db.Timestamptz(6)
  lifecycle_stage      String                     @default("draft")
  structured_note      Json?
  cantonese_categories cantonese_categories       @relation(fields: [category], references: [name], onDelete: NoAction, onUpdate: NoAction)
  corpus_category      corpus_category?
  corpus_tags          corpus_tags[]
  corpus_zyzdv2        corpus_zyzdv2[]
  userInteractions     user_corpus_interactions[]

  @@id([id, data])
  @@index([data], map: "cantonese_corpus_all_data_pgroonga_idx")
}

