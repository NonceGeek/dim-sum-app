# WeChat Web OAuth
NEXT_PUBLIC_WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=

# WeChat Miniprogram
# review-app
WECHAT_MINIPROGRAM_APPID=
WECHAT_MINIPROGRAM_SECRET=

# yue-cube-game
WECHAT_MINIPROGRAM_YUE_CUBE_GAME_APPID=
WECHAT_MINIPROGRAM_YUE_CUBE_GAME_SECRET=

# corpus-collection-app
WECHAT_MINIPROGRAM_CORPUS_COLLECTION_APPID=
WECHAT_MINIPROGRAM_CORPUS_COLLECTION_SECRET=

# NextAuth
NEXTAUTH_URL=
NEXTAUTH_SECRET=


# Connect to Supabase via connection pooling
# Vercel + Supabase transaction pooler baseline. Increase gradually only after
# checking Supabase connection metrics because every warm function has a pool.
# ?pgbouncer=true&connection_limit=3&pool_timeout=5
DATABASE_URL=

# Direct connection to the database. Used for migrations
DIRECT_URL=

# Offline semantic-neighbor reads remain disabled until a complete local build
# has been validated and activated.
SEARCH_OFFLINE_NEIGHBORS_ENABLED=false
SEARCH_OFFLINE_NEIGHBORS_WEIGHT=45
SEARCH_OFFLINE_NEIGHBORS_MAX_RANK=24
CORPUS_EMBEDDING_MODEL=qwen3-vl-embedding
# Vercel search functions call an authenticated iad1 relay so only the
# DashScope request leaves the database-adjacent sin1 region.
SEARCH_EMBEDDING_RELAY_SECRET=
# Optional outside Vercel; VERCEL_URL is used automatically when omitted.
SEARCH_EMBEDDING_RELAY_URL=
SEARCH_EMBEDDING_RELAY_TIMEOUT_MS=6000

# Ali OSS
ALIYUN_OSS_REGION=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_TIMEOUT_MS=180000

# Aliyun Model Studio / DashScope, used by entry search query embedding.
# Either DASHSCOPE_API_KEY or ALIBABA_CLOUD_DASHSCOPE_API_KEY is accepted.
DASHSCOPE_API_KEY=
ALIBABA_CLOUD_DASHSCOPE_API_KEY=

# resend email key (https://resend.com/docs)
RESEND_API_KEY=
RESEND_REGISTERED_EMAIL=

# Aliyun SMS (https://help.aliyun.com/document_detail/419273.html)
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# China endpoint: dysmsapi.aliyuncs.com
# Singapore endpoint: dysmsapi.ap-southeast-1.aliyuncs.com
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_CONNECT_TIMEOUT_MS=4000
ALIYUN_SMS_READ_TIMEOUT_MS=6000
# Vercel application APIs stay database-adjacent and call this iad1 relay.
ALIYUN_SMS_RELAY_SECRET=
# Optional outside Vercel; VERCEL_URL is used automatically when omitted.
ALIYUN_SMS_RELAY_URL=
ALIYUN_SMS_RELAY_TIMEOUT_MS=12000

#deno url
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_BACKUP_BACKEND_URL=
BACKEND_URL=
BACKEND_API_KEY=
ADMIN_PASSWORD=

# Wallet Connection (Reown/WalletConnect)
NEXT_PUBLIC_REOWN_PROJECT_ID=4416e9c350b3c4e38cc6a1a696e17e83

# AI AGENT
AGENT_API_BASE_URL=https://yue-lint-agent.api.tokentapestry.com
AGENT_API_TOKEN=xxx
CORPUS_COLLECTION_WEBHOOK_TOKEN=xxx

ALIYUN_SMS_ACCESS_KEY_ID="your-access-key-id"
ALIYUN_SMS_ACCESS_KEY_SECRET="your-access-key-secret"
ALIYUN_SMS_SIGN_NAME="短信签名名称"
ALIYUN_SMS_TEMPLATE_CODE="SMS_123456789"
